# Public base URL of this instance *required*
BASE_URL=https://short.example.com

# OIDC (Authentik) *required*
# Issuer is the provider's "OpenID Configuration Issuer", e.g. https://auth.example.com/application/o/short/
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Members of this Authentik group are admins
ADMIN_GROUP=short-admins

# Random secret for signing cookies, e.g. `openssl rand -base64 32` *required*
SESSION_SECRET=

# Where the SQLite database and uploaded avatars are stored
DATA_DIR=./data

# Timezone used for "today" and the daily stats
TIMEZONE=Europe/Berlin

# Set when running behind a reverse proxy, so X-Forwarded-For is used for the visitor IP
TRUST_PROXY=true

# Optional
#LOGO_DEV_TOKEN=
#DISABLE_ATTRIBUTION=true
#PORT=3000
